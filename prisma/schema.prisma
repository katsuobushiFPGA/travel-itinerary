// 旅のしおり Prisma schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Trip {
  id             String          @id @default(cuid())
  title          String
  destination    String?
  startDate      DateTime
  endDate        DateTime
  memo           String?
  coverImage     String?
  shareToken     String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  members        Member[]
  itineraryItems ItineraryItem[]
  packingItems   PackingItem[]
}

model Member {
  id        String   @id @default(cuid())
  tripId    String
  name      String
  role      String?
  contact   String?
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model ItineraryItem {
  id        String   @id @default(cuid())
  tripId    String
  dayIndex  Int
  startTime String
  endTime   String?
  title     String
  location  String?
  url       String?
  note      String?
  sortOrder Int      @default(0)
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, dayIndex])
}

model PackingItem {
  id        String   @id @default(cuid())
  tripId    String
  name      String
  category  String?
  owner     String?
  quantity  Int      @default(1)
  checked   Boolean  @default(false)
  sortOrder Int      @default(0)
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}
